      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "\nlet previous;\ntry { previous = $('Check decision').item.json; } catch { previous = {poll_count: 0}; }\nreturn [{json: {poll_count: previous.poll_count + 1}}];\n"
      }
    },
