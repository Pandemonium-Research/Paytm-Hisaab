      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "http://core:8000/packs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({merchant_id:$json.merchant_id, case_id:$json.case_id, pack_type:'freeze', sim_at:$json.opened_at}) }}"
