      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "\nconst view = $input.first().json;\nconst built = $('Build evidence pack').first().json;\nif (view.case.case_id !== built.case_id || view.pack_id !== built.pack_id) throw new Error('Officer decision is for a different case or pack');\nreturn [{json: {...view, poll_count: $('Poll budget').item.json.poll_count, approved:view.status === 'approved',\n  terminal:['sent','rejected','escalated'].includes(view.status)}}];\n"
      }
    },
