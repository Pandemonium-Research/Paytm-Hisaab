      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body;\nif (!b?.case_id || !b.merchant_id || !b.opened_at) throw new Error('case.opened needs case_id, merchant_id, opened_at');\nreturn [{json: {...b, max_polls: 120}}];\n"
      }
    },
    {
      "id": "9537d255-9109-536f-b405-363b25545f27",
      "name": "Build evidence pack",
      "type": "n8n-nodes-base.httpRequest",
