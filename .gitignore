# Generated datasets (reproducible: python -m sim.generate, about 30 s).
# Ignore the contents, not the folder itself, so the exception below still applies.
/data/*
!/data/README.md

# Knowledge graph, rebuilt by `graphify update .`
graphify-out/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# Secrets and credentials - never commit API keys for the sandbox
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Node, if a web or WhatsApp demo gets added
node_modules/
dist/
build/
.next/
npm-debug.log*
yarn-error.log*

# Editor and OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local Claude Code settings (keep shared .claude/ config tracked)
.claude/settings.local.json

# Logs and scratch
*.log
tmp/
scratch/

# SQLite provenance ledger, rebuilt by the nightly pass
*.db

# Hackathon voucher and reference screenshots: never in git
N8N CREDITS .docx.pdf
/design/reference/

# Live keys, whatever they are named. .env.* already covers .env.live; this covers the
# bare-name variant that is otherwise NOT ignored.
env.live
env.*.live
