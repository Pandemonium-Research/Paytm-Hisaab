# Paytm Hisaab environment (IMPLEMENTATION_PLAN.md §16 and §16a)
#
# Two files, both gitignored, never committed:
#   .env       everyday development. Copy this file as it is. Fake keys only and HISAAB_LIVE=0,
#              so a mistake cannot spend credits.
#   .env.live  real keys. Loaded on top of .env only by `python tasks.py --live ...`, and only in
#              a budgeted live window (L1-L5). Put the "LIVE KEYS" section below into it,
#              uncommented.

# ---------------------------------------------------------------- everyday (.env)

HISAAB_LIVE=0
POSTGRES_USER=hisaab
POSTGRES_PASSWORD=hisaab
# Sarvam- and Twilio-shaped stand-ins (services/fakes, 2F.1)
FAKES_URL=http://fakes:8200
FAKES_HOST_URL=http://localhost:8200
FAKES_INTERNAL_URL=http://fakes:8200
SARVAM_API_KEY=fake
TWILIO_ACCOUNT_SID=ACfake
TWILIO_AUTH_TOKEN=fake
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
FAKE_WA_FROM=whatsapp:+919999999999

# One key per role (§14). Any string locally; long random values in .env.live.
KEY_RAILS=dev-rails
KEY_PROVENANCE=dev-provenance
KEY_CONVERSATION=dev-conversation
KEY_EVIDENCE=dev-evidence
KEY_OFFICER=dev-officer
KEY_ADMIN=dev-admin
KEY_APP=dev-app

# The local n8n (compose profile local-n8n). Its API key comes from its settings page.
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=
N8N_WEBHOOK_SECRET=dev-webhook-secret
# Host-side URL used by `python tasks.py fake-wa`; it must be the exact URL WF31 receives.
FAKE_WA_WEBHOOK_URL=http://localhost:5678/webhook/hisaab/wf31-whatsapp
# Comma-separated workflow IDs whose core base URL is rewritten by live publish.
N8N_WORKFLOW_IDS=
N8N_PUBLIC_BASE_PLACEHOLDER=https://hisaab.invalid

# Memory: stub | self | hosted. Development uses stub, or self with its LLM on the fakes.
MEMORY_BACKEND=stub
# Self-hosted Cognee (MEMORY_BACKEND=self), pinned in S6 and 5.1
LLM_PROVIDER=custom
LLM_ENDPOINT=http://fakes:8200/sarvam/v1
LLM_MODEL=sarvam-105b
LLM_API_KEY=fake
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=

# Optional process-level override. Publish normally writes core's mounted runtime config.
PUBLIC_URL=

# Daily anchors (8.4). Leave the token empty to skip the GitHub commit.
ANCHOR_GITHUB_TOKEN=
ANCHOR_REPO=

# Web Push (P1, 9.12)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

SIM_SPLIT=demo
CHANNEL=both

# ---------------------------------------------------------------- LIVE KEYS (.env.live only)
#
# HISAAB_LIVE=1
#
# SARVAM_API_KEY=
#
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_SANDBOX_CODE=
# TWILIO_SANDBOX_CONFIG_URL=  Twilio REST resource used to update sandbox settings
# TWILIO_SANDBOX_WEBHOOK_FIELD=Url
# N8N_WHATSAPP_WEBHOOK_URL=   public n8n Cloud WF31 webhook
#
# MEMORY_BACKEND=hosted
# COGNEE_API_KEY=
# COGNEE_API_BASE_URL=
# COGNEE_TENANT_ID=
# COGNEE_USER_ID=
#
# N8N_BASE_URL=https://<instance>.app.n8n.cloud
# N8N_API_KEY=
# N8N_WEBHOOK_SECRET=
# N8N_WORKFLOW_IDS=
#
# KEY_RAILS=            (and the other six role keys: long random values)
#
# ANCHOR_GITHUB_TOKEN=  fine-grained, contents read/write on hisaab-anchors only
# ANCHOR_REPO=<owner>/hisaab-anchors
