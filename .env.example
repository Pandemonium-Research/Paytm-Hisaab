# Hisaab data service. Copy to .env for local runs; set the same names in Phinite
# per environment (Settings -> Environment variables).

# Which generated split to serve: demo | dev | eval | sweep
HISAAB_SPLIT=demo
HISAAB_DATA=data
HISAAB_LEDGER_DB=ledger.db

# Read + propose. Goes on BOTH graphs.
HISAAB_KEY=changeme-read

# Commit an attestation. Goes ONLY on hisaab-merchant.
# Setting this on hisaab-watch would defeat the permission boundary the pitch rests on.
HISAAB_ATTEST_KEY=changeme-attest
